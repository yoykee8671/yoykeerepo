# 이 파일을 .env 로 복사한 뒤 값을 채운다. (.env 는 git 에 올라가지 않는다)
#   cp .env.example .env
# 아래 값들 중 Render 에서 쓰던 것은 Render 대시보드 → wooofpay → Environment 에서 복사한다.

# 맥미니 로컬 Postgres 비밀번호. 새로 정하면 된다.
# URL 에 들어가므로 특수문자 없이 영문+숫자로 길게 만들 것. (예: openssl rand -hex 24)
POSTGRES_PASSWORD=

# Cloudflare 대시보드에서 터널을 만들 때 받는 토큰 (README 3단계).
CLOUDFLARE_TUNNEL_TOKEN=

# ── 이하 Render 에서 쓰던 값 그대로 ──────────────────────────────

# 최초 관리자 계정 (DB 에 관리자가 이미 있으면 사용되지 않는다)
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# 입금요청 알림 웹훅 (없으면 비워둔다)
GOOGLE_APPS_SCRIPT_WEBHOOK_URL=

# Cloudflare 뒤에서 OAuth 리다이렉트 주소를 만들 때 쓰는 공개 주소
PUBLIC_BASE_URL=https://pay.wooof.co.kr

# clobe 리프레시 토큰 암호화 키. 기존 값과 달라지면 clobe 재연결이 필요하다.
CLOBE_TOKEN_SECRET=

# Cafe24 Admin API
CAFE24_MALL_ID=
CAFE24_CLIENT_ID=
CAFE24_CLIENT_SECRET=
CAFE24_SCOPE=
