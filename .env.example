NODE_ENV=production
HOST=0.0.0.0
PORT=4173

# Supabase Postgres or any Postgres URL
DATABASE_URL=postgresql://postgres:your-password@db.your-project.supabase.co:5432/postgres

# Initial admin bootstrap on first empty database only
BOOTSTRAP_ADMIN_NAME=Owner
BOOTSTRAP_ADMIN_EMAIL=owner@wooofpay.local
# Required in production. In development, leave blank to auto-generate a temporary password printed to the server console once.
BOOTSTRAP_ADMIN_PASSWORD=

# Optional Google Sheets archive sync
GOOGLE_APPS_SCRIPT_WEBHOOK_URL=

# --- 클로브ai (clobe.ai) 입금대사 연동 ---
# Public origin used to build the OAuth redirect URI. Leave blank to derive it
# from the incoming request; set it explicitly behind a proxy or CDN.
PUBLIC_BASE_URL=
# Encrypts the stored clobe refresh token at rest (AES-256-GCM). Strongly
# recommended in production. Changing it invalidates the stored token and
# requires reconnecting from the 입금대사 tab.
CLOBE_TOKEN_SECRET=

# --- 카페24 Admin API (주문내역 자동 조회) ---
# 개발자센터(developers.cafe24.com) > App 관리에서 발급받은 값.
# Redirect URI 에 https://<PUBLIC_BASE_URL>/api/cafe24/callback 를 등록해야 합니다.
CAFE24_MALL_ID=
CAFE24_CLIENT_ID=
CAFE24_CLIENT_SECRET=
